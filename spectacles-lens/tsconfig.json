{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./types"],
    "baseUrl": ".",
    "paths": {
      "Component/*": ["./types/*"],
      "SpectaclesInteractionKit.lspkg/*": ["./types/*"]
    }
  },
  "include": [
    "Assets/Scripts/**/*.ts",
    "types/**/*.d.ts"
  ]
}
