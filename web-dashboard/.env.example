# SpecScribe Web Dashboard Environment Variables
# In Vercel Services mode, BACKEND_URL is automatically injected by the service binding into server-side functions.
# For standalone local development outside Vercel dev, NEXT_PUBLIC_API_URL can point to the FastAPI Backend:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only: bearer token the backend requires (must match the backend's SPECSCRIBE_API_TOKEN).
# Never prefix this with NEXT_PUBLIC_, or it would be exposed to the browser.
SPECSCRIBE_API_TOKEN=
