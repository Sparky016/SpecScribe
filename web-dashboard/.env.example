# SpecScribe Web Dashboard Environment Variables
# Server-side base URL of the FastAPI backend, which runs on Cloud Run (not on Vercel).
# Set this in the Vercel project env to the Cloud Run https URL, e.g.:
# BACKEND_URL=https://specscribe-backend-xxxxx-uc.a.run.app
# For standalone local development, point it at a locally running backend:
# BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL is used as a fallback when BACKEND_URL is unset.

# Server-side only: bearer token the backend requires (must match the backend's SPECSCRIBE_API_TOKEN).
# Never prefix this with NEXT_PUBLIC_, or it would be exposed to the browser.
SPECSCRIBE_API_TOKEN=
